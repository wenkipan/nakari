# Nakari 环境配置示例
# 复制此文件为 .env 并填写你的配置
# cp .env.example .env

# ============================================
# Embedding API 配置 (OpenAI 兼容格式)
# ============================================
# 支持: OpenAI, 智谱, Moonshot, DeepSeek 等

# 智谱 (Zhipu) 示例:
EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=your_zhipu_api_key_here
EMBEDDING_MODEL=embedding-3

# OpenAI 示例:
# EMBEDDING_API_BASE=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your_openai_api_key_here
# EMBEDDING_MODEL=text-embedding-3-small

# Moonshot 示例:
# EMBEDDING_API_BASE=https://api.moonshot.cn/v1
# EMBEDDING_API_KEY=your_moonshot_api_key_here
# EMBEDDING_MODEL=moonshot-v1-8k

# ============================================
# LLM API 配置 (OpenAI 兼容格式)
# ============================================

# 智谱 (Zhipu) 示例:
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your_zhipu_api_key_here
LLM_MODEL=GLM-4.7
LLM_MAX_TOKENS=4096

# OpenAI 示例:
# LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4
# LLM_MAX_TOKENS=4096

# ============================================
# Neo4j 图数据库配置
# ============================================
# Docker 环境下会自动覆盖这些值

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# ============================================
# Redis 配置 (Celery Broker)
# ============================================
# Docker 环境下会自动覆盖这些值

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================
# 可选配置
# ============================================

# Celery Worker 并发数
CELERY_WORKER_CONCURRENCY=4
